# 쿠팡 파트너스 API 인증 키
COUPANG_ACCESS_KEY=your_coupang_access_key_here
COUPANG_SECRET_KEY=your_coupang_secret_key_here
COUPANG_SUB_ID=my_affiliate_id

# Meta Threads API 인증 정보
THREADS_ACCESS_TOKEN=your_threads_access_token_here
THREADS_USER_ID=your_threads_user_id_here

# Instagram 계정 정보 (instagrapi용)
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# AI 비전 및 마케팅 문구 분석 API (Gemini / OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ✅ 무료 고성능 AI 폴백 (Gemini 뻗어도 자동 전환됨)
# Groq — 무료, 초고속, Llama 4 / Llama 3.3 70B 사용 가능
# 키 발급: https://console.groq.com (5분, 카드 불필요)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter — 무료, DeepSeek R1 / Gemma 3 27B 사용 가능
# 키 발급: https://openrouter.ai (5분, 카드 불필요)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Ollama 로컬 모델 설정 (선택 — 로컬 설치 시)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen3
