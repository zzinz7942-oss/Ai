# ─── Unsplash API ─────────────────────────────────────────────
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# ─── OpenAI (DALL-E) - 선택 사항 ──────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ─── Google Blogger ────────────────────────────────────────────
BLOGGER_BLOG_ID=your_blogger_blog_id_here
GOOGLE_API_KEY=your_google_api_key_here

# ─── 이미지 전략 선택 ──────────────────────────────────────────
IMAGE_STRATEGY=unsplash

# ─── 포스트 기본 상태 ──────────────────────────────────────────
POST_STATUS=DRAFT

# ─── ✍️ 고유 어조 및 스타일 ───────────────────────────────────
WRITER_TONE=전문적이면서도 친근한 어조 (~합니다/해드립니다 체)
WRITER_STYLE=데이터 기반 객관적 비교, 소제목 구조화, 실용 팁 강조
WRITER_PERSONA=10년 차 테크 큐레이터

# ─── 🔥 실시간 트렌드 반영 ───────────────────────────────────
ENABLE_TREND_REFLECT=true
